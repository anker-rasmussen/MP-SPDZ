# Personal CONFIG file #
##############################
CONFIG.mine
config_mine.py
# Exception: this fork's CONFIG.mine pins Boost to ./pinned-boost via rpath
# (see comments in the file). It is required to reproduce the pinned build,
# so it must be tracked despite the blanket ignore above.
!CONFIG.mine

